# Maestro E2E — environment variables
# Copy to .env (gitignored) and fill in the Supabase secret key.
# Run `supabase status` while the local stack is running to get the keys.
#
# Usage:
#   pnpm test:maestro:seed       — seeds test data into local Supabase
#   maestro test .maestro/flows  — runs all flows against the iOS simulator
#   pnpm test:maestro:teardown   — removes test data

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=              # from `supabase status` → "secret key"

# Fixed test credentials — keep in sync with seed.mjs defaults
MAESTRO_TEST_LID_EMAIL=maestro-testlid@e2e.scmuiden.test
MAESTRO_TEST_REGISTER_EMAIL=maestro-testregister@e2e.scmuiden.test
MAESTRO_TEST_PASSWORD=MaestroTestWachtwoord123!
