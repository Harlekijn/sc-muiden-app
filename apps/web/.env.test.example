# E2E test environment variables
# --------------------------------
# Copy this file to .env.test.local (gitignored) and fill in the values.
# Run `supabase status` while the local stack is running to get the keys.
#
# Required for: playwright webServer (Next.js) + global-setup seeding

# Local Supabase URL — always this for the default CLI port
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# From `supabase status` → "publishable key" (replaces legacy anon key)
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# From `supabase status` → "secret key" (replaces legacy service_role key)
# Used by global-setup.ts to create/delete test users — NEVER expose this in the browser
SUPABASE_SECRET_KEY=
